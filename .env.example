# Copy this file to .env.local and fill in the values.

# Google OAuth Client ID — console.cloud.google.com → APIs & Services → Credentials
# Client-side: this one IS bundled into the app, which is fine for an OAuth client ID.
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Groq API key — console.groq.com/keys
# Server-side ONLY. No VITE_ prefix, so it never reaches the browser bundle.
# In production set this in Vercel → Settings → Environment Variables.
GROQ_API_KEY=gsk_your_key_here

# Optional — override the model used for food analysis.
# Must be a Groq model that supports strict json_schema output.
# GROQ_MODEL=openai/gpt-oss-120b
